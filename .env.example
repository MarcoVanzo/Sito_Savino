APP_NAME="Savino Del Bene Volley"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PREVIEW_AUTH_USER=
PREVIEW_AUTH_PASS=

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry — lasciare VUOTO in sviluppo: senza DSN il client è inerte e non apre
# nessuna connessione. Riempirlo solo per riprodurre un problema di reporting.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Database: MySQL 8 (identico a produzione)
# Avviare con: docker compose up -d
# Per usare SQLite come alternativa rapida: DB_CONNECTION=sqlite (senza host/port/user/pass)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sito_savino
DB_USERNAME=sito_savino
DB_PASSWORD=secret
# Solo per connessioni al MySQL gestito DigitalOcean (TLS con verifica del CA):
# percorso del certificato CA scaricato dal pannello DO.
# MYSQL_ATTR_SSL_CA=/path/to/ca-certificate.crt

# Sviluppo: redis (se disponibile). Produzione DigitalOcean: database
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# In produzione impostare a true:
# SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
# Disco usato da Spatie Media Library. Produzione DigitalOcean: s3
MEDIA_DISK=public
# Sviluppo: redis (se disponibile). Produzione DigitalOcean: database
QUEUE_CONNECTION=redis

# Sviluppo: redis (se disponibile). Produzione DigitalOcean: database
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Client predis (pure PHP, nessuna estensione C richiesta)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
# Deve combaciare con DOCKER_REDIS_PASSWORD in docker-compose.yml (default: secret)
REDIS_PASSWORD=secret
REDIS_PORT=6379

# Sviluppo: log (le mail finiscono in storage/logs).
# Produzione: resend — impostare MAIL_MAILER=resend + RESEND_API_KEY e un
# MAIL_FROM_ADDRESS su un dominio verificato su Resend, altrimenti tutte le mail
# transazionali (ordini, aste, reset password) NON vengono consegnate.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (mailer transazionale di produzione)
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fra1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com

# ActiveCampaign Newsletter
ACTIVECAMPAIGN_URL=https://your-account.api-us1.com
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_LIST_ID=

# Google Analytics 4 — lettura dei dati nel pannello
# Il service account non deve stare nel repository: qui va il percorso di un
# file fuori dal progetto, oppure il JSON stesso (anche in base64) iniettato
# come secret cifrato di App Platform. La sua email va poi aggiunta come
# Visualizzatore su ogni proprietà GA4.
# Il Measurement ID (G-XXXXXXXXXX) NON sta qui: si imposta dal pannello, in
# Impostazioni → Analytics, perché cambia senza bisogno di un rilascio.
GA4_SERVICE_ACCOUNT_FILE=
GA4_SERVICE_ACCOUNT_JSON=

# Meta (Instagram + Facebook) — app usata per collegare gli account social
# L'app va creata dentro il portfolio business che possiede Pagine e profili
# Instagram: così basta lo Standard Access e non serve l'App Review.
# META_CONFIG_ID è l'ID della configurazione di "Facebook Login for Business":
# deve includere read_insights, altrimenti le metriche della Pagina arrivano
# vuote senza che Meta segnali alcun errore.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Solo se il dominio pubblico non coincide con APP_URL: Meta pretende che
# l'URI di reindirizzamento sia identico a quello dichiarato nell'app.
META_REDIRECT_URI=
# Il Pixel di Meta (misurazione pubblicitaria sul sito) si carica per tutti.
# Portandolo a true si subordina al consenso di marketing del banner cookie.
# L'ID del pixel NON sta qui: si imposta dal pannello, in Impostazioni → Analytics.
META_PIXEL_REQUIRES_CONSENT=false

VITE_APP_NAME="${APP_NAME}"
COMPREFACE_HOST=http://localhost:8000
COMPREFACE_KEY=00000000-0000-0000-0000-000000000001

# === E-Commerce ===
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
# Nome letto da config/services.php: PAYPAL_CLIENT_SECRET (non PAYPAL_SECRET)
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Broadcast (Pusher / Reverb) — usa 'log' come default sicuro; impostare 'pusher' nel .env locale
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
