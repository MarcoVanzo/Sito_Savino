{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "build": "vite build && vite build --ssr",
        "build:prod": "vite build",
        "build:ssr": "vite build --ssr",
        "dev": "vite",
        "heroku-postbuild": "echo 'Skipping auto-build'",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write \"resources/js/**/*.{js,vue}\"",
        "format:check": "prettier --check \"resources/js/**/*.{js,vue}\"",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@guidepup/virtual-screen-reader": "^0.33.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "autoprefixer": "^10.6.1",
        "axe-core": "^4.14.0",
        "concurrently": "^9.2.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "eslint-plugin-vuejs-accessibility": "^2.6.3",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^3.2.0",
        "postcss": "^8.5.31",
        "postcss-nesting": "^14.0.3",
        "prettier": "^3.9.10",
        "tailwindcss": "^3.4.19",
        "tailwindcss4": "npm:tailwindcss@^4.3.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.9.1",
        "@sentry/vue": "^11.8.0",
        "@vue/server-renderer": "^3.5.44",
        "axios": "^1.20.0",
        "dompurify": "^3.4.17",
        "jsdom": "^29.1.1",
        "vue": "^3.5.44"
    }
}
