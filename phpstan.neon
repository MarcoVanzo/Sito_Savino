# Larastan (PHPStan for Laravel) — Level 5 configuration
# Balanced between strictness and pragmatism for a Laravel + Filament project
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
    level: 5
    # I cast stanno nel metodo casts(): senza questa opzione Larastan legge il
    # tipo dichiarato (array generico) e perde enum, date e decimali dei modelli.
    parseModelCastsMethod: true
    ignoreErrors:
        # Filament dynamic $form property on custom pages
        - identifier: property.notFound
          path: app/Filament/*
        # Filament dynamic method calls
        - identifier: method.notFound
          path: app/Filament/*
        # Filament nullCoalesce edge cases
        # `nullCoalesce.expr` è stato rimosso: serviva a coprire i `?->prop ??`
        # dei Resource, ora eliminati. Il null coalescing usa già la semantica
        # di isset() e sopprime l'accesso a proprietà su null, quindi il
        # nullsafe alla sua sinistra non aggiungeva niente.
        - identifier: nullCoalesce.offset
          path: app/Filament/*
        # Filament defensive is_array() checks on PHPDoc-typed arrays
        - identifier: function.alreadyNarrowedType
          path: app/Filament/*
    # Nessuna excludePaths: i comandi schedulati (ordini, aste, magazzino) toccano
    # denaro e stock e devono restare sotto analisi statica.
    #
    # reportUnmatchedIgnoredErrors: true è deliberato. Con false la baseline era
    # monodirezionale: le voci restavano valide anche dopo che l'errore era stato
    # corretto, e continuavano a coprire codice nuovo scritto nello stesso punto.
    # Con true, una voce che non corrisponde più a nulla fa fallire l'analisi e va
    # rimossa. La baseline è stata svuotata e tolta il 01/10/2026: un errore nuovo
    # si corregge, non si rimanda in un file che nessuno rilegge.
    reportUnmatchedIgnoredErrors: true
