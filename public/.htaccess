<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compressione Gzip/Deflate
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
    AddOutputFilterByType DEFLATE application/x-font-ttf application/x-font-opentype
    AddOutputFilterByType DEFLATE font/opentype font/ttf font/otf
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# Cache headers per asset statici (Vite aggiunge hash ai nomi file)
<IfModule mod_expires.c>
    ExpiresActive On

    # Immagini — 1 anno (cache-busting via nome file con hash Vite)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS e JS — 1 anno (Vite produce nomi con content hash)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Font — 1 anno
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # NIENTE regola per text/html: mod_expires non aggiunge solo Expires ma
    # anche un proprio Cache-Control (max-age=0), che l'edge di App Platform
    # concatena a quello di Laravel producendo "no-cache, private,max-age=0".
    # Le risposte dinamiche gli header li hanno già dal framework.
</IfModule>

# Header aggiuntivi per il caching
<IfModule mod_headers.c>
    # Asset nella cartella build/ (Vite) — immutable perché hanno hash nel nome
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # NIENTE Cache-Control sulle risposte PHP: lo decide Laravel. Il blocco che
    # stava qui aggiungeva un secondo header Cache-Control che l'edge di App
    # Platform concatenava a quello del framework, producendo il valore
    # malformato "no-cache, private,no-cache, no-store, must-revalidate" su
    # ogni pagina — e avrebbe scavalcato anche gli header voluti (la sitemap
    # è servita con public, max-age=3600).
</IfModule>
